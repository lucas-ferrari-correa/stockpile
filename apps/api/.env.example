NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stockpile:stockpile@localhost:5432/stockpile
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
EXCHANGE_CURRENCIES=EUR,GBP,JPY,CNY,CAD,BRL,COP
EXCHANGE_RATES_TIMEOUT_MS=2000
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN_SECONDS=3600
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=104857600
IMPORT_CONCURRENCY=2
IMPORT_JOB_ATTEMPTS=3
IMPORT_JOB_BACKOFF_MS=1000
IMPORT_RECONCILE_INTERVAL_MS=30000
IMPORT_RECONCILE_AFTER_MS=60000
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_ACCESS_REQUEST_LIMIT=3
THROTTLE_ACCESS_REQUEST_TTL_MS=3600000
TRUST_PROXY_HOPS=0
ADMIN_EMAIL=admin@stockpile.local
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
