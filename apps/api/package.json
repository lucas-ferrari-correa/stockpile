{
  "name": "@stockpile/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "start:dev": "dotenv -e .env -- nest start --watch",
    "start:worker:dev": "dotenv -e .env -- nest start --watch --entryFile worker",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e .env -- prisma db seed",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset --force",
    "prisma:studio": "dotenv -e .env -- prisma studio"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "^6.19.3",
    "@stockpile/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "big.js": "7.0.1",
    "bullmq": "6.4.2",
    "busboy": "1.6.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/big.js": "7.0.0",
    "@types/busboy": "1.5.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}
