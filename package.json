{
  "name": "stockpile",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait && pnpm --filter @stockpile/api prisma:deploy",
    "dataset:generate": "tsx scripts/generate-dataset.ts",
    "dataset:sample": "tsx scripts/generate-dataset.ts --rows 2000 --seed 20260101 --dirty-ratio 0.05 --repeat-identity-ratio 0.1 --out data/sample-inventory.csv"
  },
  "devDependencies": {
    "@date-fns/utc": "^2.1.1",
    "@faker-js/faker": "10.6.0",
    "@types/node": "^22.20.5",
    "big-list-of-naughty-strings": "1.0.0",
    "csv-stringify": "^6.9.0",
    "currency.js": "^2.0.4",
    "date-fns": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
